.index-shell {
    -webkit-align-items: center;
    align-items: center;
    background: linear-gradient(160deg,#f5f1e8,#f8f4ec 48%,#f2eee5);
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center;
    min-height: 100vh;
    overflow: hidden;
    padding: 0 40rpx;
    position: relative
}

.blob {
    -webkit-animation: float 10s ease-in-out infinite;
    animation: float 10s ease-in-out infinite;
    border-radius: 50%;
    -webkit-filter: blur(80px);
    filter: blur(80px);
    opacity: .7;
    position: absolute;
    z-index: 0
}

.blob-1 {
    -webkit-animation-delay: 0s;
    animation-delay: 0s;
    background: rgba(166,140,92,.2);
    height: 500rpx;
    left: -80rpx;
    top: -100rpx;
    width: 500rpx
}

.blob-2 {
    -webkit-animation-delay: -5s;
    animation-delay: -5s;
    background: rgba(121,141,110,.2);
    bottom: -150rpx;
    height: 600rpx;
    right: -100rpx;
    width: 600rpx
}

@-webkit-keyframes float {
    0%,100% {
        -webkit-transform: translate(0,0) scale(1);
        transform: translate(0,0) scale(1)
    }

    33% {
        -webkit-transform: translate(30rpx,-40rpx) scale(1.05);
        transform: translate(30rpx,-40rpx) scale(1.05)
    }

    66% {
        -webkit-transform: translate(-20rpx,30rpx) scale(.95);
        transform: translate(-20rpx,30rpx) scale(.95)
    }
}

@keyframes float {
    0%,100% {
        -webkit-transform: translate(0,0) scale(1);
        transform: translate(0,0) scale(1)
    }

    33% {
        -webkit-transform: translate(30rpx,-40rpx) scale(1.05);
        transform: translate(30rpx,-40rpx) scale(1.05)
    }

    66% {
        -webkit-transform: translate(-20rpx,30rpx) scale(.95);
        transform: translate(-20rpx,30rpx) scale(.95)
    }
}

.hero-elegant {
    -webkit-align-items: center;
    align-items: center;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    -webkit-justify-content: center;
    justify-content: center;
    min-height: 62vh;
    padding: 104rpx 24rpx 76rpx;
    position: relative;
    text-align: center;
    width: 100%;
    z-index: 10
}

.badge-up {
    background: rgba(154,131,88,.12);
    border: 1px solid rgba(154,131,88,.3);
    border-radius: 999rpx;
    color: #8b6a35;
    display: inline-block;
    font-size: 22rpx;
    font-weight: 700;
    letter-spacing: .1em;
    margin-bottom: 48rpx;
    padding: 12rpx 28rpx
}

.h1 {
    font-family: "Times New Roman","Georgia","STSong","Songti SC",serif;
    font-size: 74rpx;
    font-weight: 700;
    letter-spacing: .01em;
    line-height: 1.2;
    margin-bottom: 0
}

.hero-title-line {
    display: block
}

.hero-divider {
    background: linear-gradient(90deg,rgba(127,104,64,.08),rgba(127,104,64,.35),rgba(127,104,64,.08));
    border-radius: 999rpx;
    height: 2rpx;
    margin: 38rpx 0 34rpx;
    width: 72%
}

.gradient-text {
    -webkit-text-fill-color: transparent;
    background: linear-gradient(135deg,#2f3d2e,#4b5d49 55%,#7f6840);
    -webkit-background-clip: text;
    color: #304034
}

.hero-desc {
    color: #5b5548;
    font-family: "Noto Serif SC","Source Han Serif SC","STSong","Songti SC",serif;
    font-size: 32rpx;
    font-weight: 400;
    line-height: 1.95;
    margin-bottom: 84rpx;
    max-width: 620rpx;
    padding: 0;
    text-align: justify;
    text-align-last: center
}

.hero-actions-single {
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center;
    width: 100%
}

.hero-actions-single wx-button {
    border-radius: 999rpx;
    background: linear-gradient(135deg,#4e604a,#607a59);
    border: none;
    box-shadow: 0 12rpx 24rpx rgba(58,74,54,.24);
    color: #fff;
    font-family: "PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
    font-size: 30rpx;
    font-weight: 600;
    height: 100rpx;
    letter-spacing: .05em;
    transition: box-shadow .2s ease,-webkit-transform .2s ease;
    transition: transform .2s ease,box-shadow .2s ease;
    transition: transform .2s ease,box-shadow .2s ease,-webkit-transform .2s ease;
    width: 78%
}

.hero-actions-single wx-button:active {
    box-shadow: 0 6rpx 12rpx rgba(58,74,54,.16);
    -webkit-transform: scale(.96);
    transform: scale(.96)
}

.animate-pulse {
    -webkit-animation: pulse 2.5s infinite;
    animation: pulse 2.5s infinite
}

@-webkit-keyframes pulse {
    0% {
        box-shadow: 0 0 0 0 rgba(96,122,89,.3)
    }

    70% {
        box-shadow: 0 0 0 28rpx rgba(96,122,89,0)
    }

    100% {
        box-shadow: 0 0 0 0 rgba(91,122,98,0)
    }
}

@keyframes pulse {
    0% {
        box-shadow: 0 0 0 0 rgba(96,122,89,.3)
    }

    70% {
        box-shadow: 0 0 0 28rpx rgba(96,122,89,0)
    }

    100% {
        box-shadow: 0 0 0 0 rgba(91,122,98,0)
    }
}

.credits {
    color: rgba(115,98,67,.72);
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    font-family: "Times New Roman","Georgia","STSong","Songti SC",serif;
    font-size: 23rpx;
    gap: 12rpx;
    line-height: 1.6;
    letter-spacing: .07em;
    margin-top: 72rpx
}
