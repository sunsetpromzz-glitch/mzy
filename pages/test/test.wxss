.test-shell {
    background: linear-gradient(160deg,#f5f1e8,#f8f4ec 48%,#f2eee5);
    min-height: 100vh;
    overflow: hidden;
    position: relative
}

.blob {
    -webkit-animation: float 11s ease-in-out infinite;
    animation: float 11s ease-in-out infinite;
    border-radius: 50%;
    -webkit-filter: blur(80px);
    filter: blur(80px);
    opacity: .55;
    position: absolute;
    z-index: 0
}

.blob-1 {
    background: rgba(166,140,92,.2);
    height: 420rpx;
    left: -100rpx;
    top: -120rpx;
    width: 420rpx
}

.blob-2 {
    -webkit-animation-delay: -5s;
    animation-delay: -5s;
    background: rgba(121,141,110,.18);
    bottom: -160rpx;
    height: 520rpx;
    right: -140rpx;
    width: 520rpx
}

@-webkit-keyframes float {
    0%,100% {
        -webkit-transform: translate(0,0) scale(1);
        transform: translate(0,0) scale(1)
    }

    50% {
        -webkit-transform: translate(24rpx,-28rpx) scale(1.05);
        transform: translate(24rpx,-28rpx) scale(1.05)
    }
}

@keyframes float {
    0%,100% {
        -webkit-transform: translate(0,0) scale(1);
        transform: translate(0,0) scale(1)
    }

    50% {
        -webkit-transform: translate(24rpx,-28rpx) scale(1.05);
        transform: translate(24rpx,-28rpx) scale(1.05)
    }
}

.test-wrap {
    margin-top: 22rpx;
    padding: 22rpx;
    position: relative;
    z-index: 1
}

.paper-head {
    margin: 10rpx 8rpx 26rpx;
    text-align: center
}

.badge-up {
    background: rgba(154,131,88,.12);
    border: 1px solid rgba(154,131,88,.28);
    border-radius: 999rpx;
    color: #8b6a35;
    display: inline-block;
    font-size: 20rpx;
    font-weight: 700;
    letter-spacing: .12em;
    margin-bottom: 18rpx;
    padding: 10rpx 24rpx
}

.paper-title {
    color: #394336;
    font-family: "Times New Roman","Georgia","STSong","Songti SC",serif;
    font-size: 48rpx;
    letter-spacing: .02em;
    line-height: 1.3;
    margin-bottom: 8rpx
}

.paper-sub {
    color: #736545;
    font-size: 25rpx
}

.topbar {
    -webkit-align-items: center;
    align-items: center;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    background: transparent;
    border-bottom: none;
    border-radius: 0;
    display: -webkit-flex;
    display: flex;
    gap: 14rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    margin: 0 0 34rpx;
    padding: 0;
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    z-index: 100
}

.progress {
    background: rgba(123,104,76,.12);
    border-radius: 999rpx;
    -webkit-flex: 1;
    flex: 1;
    height: 8rpx;
    min-width: 240rpx;
    overflow: hidden;
    position: relative
}

.progress-bar {
    background: #6a7f63;
    border-radius: inherit;
    height: 100%;
    transition: width .25s ease;
    width: 0
}

.progress-text {
    color: #8a7b60;
    font-size: 24rpx;
    letter-spacing: .04em;
    white-space: nowrap
}

.question-list {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    gap: 32rpx
}

.question {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0
}

.question-meta {
    color: #867a62;
    display: -webkit-flex;
    display: flex;
    font-size: 24rpx;
    gap: 24rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    margin-bottom: 20rpx
}

.badge,.question-meta {
    -webkit-align-items: center;
    align-items: center
}

.badge {
    background: rgba(154,131,88,.1);
    border: 1px solid rgba(154,131,88,.2);
    border-radius: 999rpx;
    display: -webkit-inline-flex;
    display: inline-flex;
    gap: 12rpx;
    padding: 12rpx 20rpx
}

.question-title {
    color: #403a30;
    font-family: "Noto Serif SC","Source Han Serif SC","STSong","Songti SC",serif;
    font-size: 35rpx;
    font-weight: 500;
    line-height: 1.85;
    margin-bottom: 28rpx;
    white-space: pre-wrap
}

.options {
    -webkit-flex-direction: column;
    flex-direction: column;
    gap: 0
}

.option,.options {
    display: -webkit-flex;
    display: flex
}

.option {
    -webkit-align-items: flex-start;
    align-items: flex-start;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(163,140,99,.18);
    border-radius: 0;
    gap: 0;
    padding: 28rpx 10rpx;
    transition: all .16s ease
}

.option+.option {
    margin-top: 12rpx
}

.option.selected {
    background: rgba(166,140,92,.05);
    border-bottom-color: #8f7548
}

.option wx-radio {
    -webkit-transform: scale(.9);
    transform: scale(.9);
    -webkit-flex: 0 0 56rpx;
    flex: 0 0 56rpx;
    margin-top: 2rpx
}

.option-code {
    color: #7a6137;
    font-weight: 800;
    -webkit-flex: 0 0 52rpx;
    flex: 0 0 52rpx;
    text-align: center
}

.option.selected .option-code {
    color: #5f7859
}

.option>view:last-child {
    -webkit-flex: 1;
    flex: 1;
    line-height: 1.6
}

.actions-bottom {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    gap: 24rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    margin-top: 36rpx;
    padding-top: 24rpx
}

.hint {
    color: #665d4e;
    font-size: 26rpx;
    line-height: 1.8;
    width: 100%
}

.btn-group {
    display: -webkit-flex;
    display: flex;
    gap: 12rpx;
    -webkit-justify-content: flex-end;
    justify-content: flex-end;
    -webkit-flex-wrap: nowrap;
    flex-wrap: nowrap;
    width: 100%
}

.btn-group wx-button {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 20rpx;
    display: -webkit-flex;
    display: flex;
    -webkit-flex: 1;
    flex: 1;
    font-size: 27rpx;
    -webkit-justify-content: center;
    justify-content: center;
    line-height: 1.35;
    min-height: 84rpx;
    min-width: 0;
    padding: 14rpx 10rpx;
    white-space: nowrap
}

.btn-group .btn-primary {
    background: linear-gradient(135deg,#4e604a,#607a59);
    border: none;
    box-shadow: 0 12rpx 24rpx rgba(58,74,54,.2);
    color: #fff
}

.btn-group .btn-secondary {
    background: rgba(255,255,255,.7);
    border: 1px solid rgba(163,140,99,.3);
    color: #5f5543
}
